# Cloudflare Pages response headers.
#
# COOP/COEP make this a cross-origin-isolated secure context, so SharedArrayBuffer
# is available for the decode worker's interrupt buffer. Every runtime asset is
# first-party, so require-corp costs nothing here. Remove these two lines if a
# future third-party embed needs to load without CORP.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Vite hashes these names. They may be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/pyodide/*
  Cache-Control: public, max-age=31536000, immutable

/decoders/*
  Cache-Control: public, max-age=31536000, immutable

# Entry points that change on every deploy, including the offline shell.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/favicon.svg
  Cache-Control: no-cache

/icons/*
  Cache-Control: no-cache

# The standalone firmware-update page under /ota/ has its own hashed assets and a
# mutable manifest. Its HTML and manifest must revalidate; its assets may not.
/ota/
  Cache-Control: no-cache

/ota/index.html
  Cache-Control: no-cache

/ota/firmware.json
  Cache-Control: no-cache

/ota/assets/*
  Cache-Control: public, max-age=31536000, immutable
